# Canonical site origin (no trailing slash)
SITE_URL=https://floatboat.ai

# subdirectory | subdomain | standalone
DEPLOY_MODE=subdirectory

# Blog path on main domain (default /blog)
BLOG_BASE_PATH=/blog

# Set when mounted at floatboat.ai/blog via Cloudflare/Railway rewrite
# ASSET_PREFIX=/blog

# Local development server port
# PORT=3777

# Public collector. Local independent preview posts to this app's
# /api/analytics/events, which HMAC-forwards to attribution.
# Production behind floatboat.ai/blog should keep the collector pointed at
# the main site:
# NEXT_PUBLIC_ATTRIBUTION_WEB_EVENT_URL=https://floatboat.ai/api/analytics/events
NEXT_PUBLIC_ATTRIBUTION_WEB_EVENTS_ENABLED=false

# Server-side HMAC forward used by /api/analytics/events.
# Local:
# ATTRIBUTION_BACKEND_BASE_URL=http://127.0.0.1:8080
# ATTRIBUTION_CLIENT_HMAC_SECRET=aoe_dev_hmac_secret
