# Canonical site origin (no trailing slash)
SITE_URL=https://floatboat.ai

# subdirectory | subdomain | standalone
DEPLOY_MODE=subdirectory

# Blog path on main domain (default /blog)
BLOG_BASE_PATH=/blog

# Set when mounted at floatboat.ai/blog via Cloudflare/Railway rewrite
# ASSET_PREFIX=/blog

# Local development server port
# PORT=3777

# Public main-site endpoint used by the static Blog attribution collector.
# Leave disabled for local-only previews.
NEXT_PUBLIC_ATTRIBUTION_WEB_EVENTS_ENABLED=false
# Production behind floatboat.ai/blog:
# NEXT_PUBLIC_ATTRIBUTION_WEB_EVENT_URL=https://floatboat.ai/api/analytics/events
